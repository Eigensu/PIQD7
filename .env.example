# Copy to .env at the repo root (it is gitignored). Both apps read this one file.

# --- Backend (apps/backend) ---
PORT=4000
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# MongoDB (Atlas or local). The database name is separate from the URI.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=App
MONGODB_DB_NAME=justlovedit

# Google OAuth client (Google Cloud Console > Credentials > Web application).
# Authorized redirect URI: http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the login cookie (JWT). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Frontend (apps/frontend) ---
# The only variable the browser can see. Defaults to http://localhost:4000.
NEXT_PUBLIC_API_URL=http://localhost:4000
